{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  // The Next.js apps have their own tsconfigs (bundler resolution + JSX);
  // their checks are `npm run typecheck --workspace apps/dashboard|console`.
  "exclude": ["apps/dashboard", "apps/console", "**/node_modules", "**/dist", "**/.next"]
}

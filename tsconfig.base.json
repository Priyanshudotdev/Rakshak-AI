{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  // The Next.js dashboard has its own tsconfig (bundler resolution + JSX);
  // its check is `npm run typecheck --workspace apps/dashboard`.
  "exclude": ["apps/dashboard", "**/node_modules", "**/dist", "**/.next"]
}

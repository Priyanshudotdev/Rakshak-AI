# Media-gateway image: WS audio transport, no AI logic.
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY services/media-gateway/package.json ./services/media-gateway/
COPY packages/types/package.json ./packages/types/
COPY packages/events/package.json ./packages/events/
COPY packages/config/package.json ./packages/config/
COPY packages/logger/package.json ./packages/logger/
COPY packages/types/tsconfig.json ./packages/types/
COPY packages/events/tsconfig.json ./packages/events/
COPY packages/config/tsconfig.json ./packages/config/
COPY packages/logger/tsconfig.json ./packages/logger/
COPY services/media-gateway/tsconfig.json ./services/media-gateway/
RUN npm ci --no-audit --no-fund

FROM deps AS build
COPY packages/types/src ./packages/types/src
COPY packages/events/src ./packages/events/src
COPY packages/config/src ./packages/config/src
COPY packages/logger/src ./packages/logger/src
COPY services/media-gateway/src ./services/media-gateway/src
RUN npm run build --workspace @rakshak/types \
 && npm run build --workspace @rakshak/config \
 && npm run build --workspace @rakshak/logger \
 && npm run build --workspace @rakshak/events \
 && npm run build --workspace @rakshak/media-gateway

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=build /app/services/media-gateway/dist ./services/media-gateway/dist
COPY --from=build /app/services/media-gateway/package.json ./services/media-gateway/package.json
COPY --from=build /app/packages ./packages
EXPOSE 3002
CMD ["node", "services/media-gateway/dist/index.js"]
